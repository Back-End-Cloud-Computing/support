# Cópia de referência (docs/arquitetura.md, seção Configuração). Copie para .env e ajuste.
# INTERNAL_SECRET aqui é só um valor de exemplo; no cluster ele vem de um Secret não versionado.
PORT=8090
INTERNAL_SECRET=troque-este-valor-local
DB_PATH=./data/support.db
LOG_LEVEL=info

# E-mail: smtp (Mailpit local em localhost:1025, UI em localhost:8025) ou fake
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@ganjj.local

# SMS e WhatsApp: fake por enquanto (plano real em docs/canais-reais.md)
SMS_PROVIDER=fake
WHATSAPP_PROVIDER=fake

# RabbitMQ opcional: vazio mantém apenas HTTP
AMQP_URL=
# Twilio: preencher somente ao selecionar SMS_PROVIDER/WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# Trial SMS: modelo fixo permitido pela conta; vazio mantém o texto do pedido
TWILIO_SMS_TRIAL_TEMPLATE=
